{
  "name": "controlmax-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "cross-env LOCAL_DEV=true tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "cross-env LOCAL_DEV=true node dist/server.js",
    "seed:qa-user": "tsx scripts/seedQaUser.ts",
    "seed:client": "tsx scripts/seedInitialClient.ts",
    "test:bff": "vitest run tests/bff.test.ts",
    "test": "vitest run tests/"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
