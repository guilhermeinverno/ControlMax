rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net catch-all - matches everything, defaults to deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSuperAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin') ||
        (request.auth.token != null && 
         'role' in request.auth.token && 
         request.auth.token.role == 'superadmin')
      );
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userTenantId() {
      return (request.auth != null) ? (
        isSuperAdmin() ? 'super_admin_tenant' :
        (userExists() && 'tenantId' in userDoc().data ? userDoc().data.tenantId : '')
      ) : '';
    }
    
    function userRole() {
      return (request.auth != null) ? (
        isSuperAdmin() ? 'admin' : 
        (userExists() && 'role' in userDoc().data ? userDoc().data.role : 'collector')
      ) : 'collector';
    }

    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (tenantId == 'super_admin_tenant' && isSuperAdmin());

      match /roles/{roleId} {
        allow read, write: if isAuthenticated() && (isSuperAdmin() || tenantId == userTenantId());
      }
    }

    // RBAC dinâmico — leitura no client; escrita apenas Admin SDK / BFF
    match /tenant_roles/{roleId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow list: if isAuthenticated() && (isSuperAdmin() || userTenantId() != '');
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isAuthenticated() && (
        isSuperAdmin() || 
        request.auth.uid == userId || 
        resource.data.tenantId == userTenantId() || 
        (request.auth.token != null && 'email' in request.auth.token && (resource.data.email == request.auth.token.email || resource.data.email.lower() == request.auth.token.email.lower()))
      );

      allow list: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.tenantId == userTenantId() || 
        (request.auth.token != null && 'email' in request.auth.token && (resource.data.email == request.auth.token.email || resource.data.email.lower() == request.auth.token.email.lower()))
      );
      
      allow create: if false;

      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          userRole() == 'admin' && 
          resource.data.tenantId == userTenantId() && 
          request.resource.data.tenantId == userTenantId() &&
          !(request.resource.data.role in ['admin', 'superadmin']) &&
          (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin != true)
        ) ||
        (
          request.auth.uid == userId && 
          resource.data.role == request.resource.data.role && 
          resource.data.tenantId == request.resource.data.tenantId &&
          (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == resource.data.isSuperAdmin)
        )
      );

      allow delete: if false;
    }

    
    match /clients/{clientId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow write: if isAuthenticated() && (isSuperAdmin() || request.resource.data.tenantId == userTenantId());
    }

    match /customers/{customerId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow write: if isAuthenticated() && (isSuperAdmin() || request.resource.data.tenantId == userTenantId());
    }

    // --- COLEÇÕES FINANCEIRAS: ESCRITAS PROIBIDAS NO CLIENT-SIDE ---
    match /sales/{saleId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow list: if isAuthenticated() && (isSuperAdmin() || userTenantId() != '');
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow write: if false;
    }

    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow write: if false;
    }

    match /incomes/{incomeId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow write: if false;
    }

    match /collections/{collectionId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow list: if isAuthenticated() && (isSuperAdmin() || userTenantId() != '');
      // FIN-01: escritas apenas via Admin SDK / BFF (igual sales/boxes)
      allow create, update, delete: if false;
    }

    match /transfers/{transferId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow write: if false;
    }

    match /boxes/{boxId} {
      allow get: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow list: if isAuthenticated() && (isSuperAdmin() || userTenantId() != '');
      allow create, update, delete: if false;


      match /transactions/{txId} {
        allow read: if isAuthenticated() && (
          isSuperAdmin() || 
          get(/databases/$(database)/documents/boxes/$(boxId)).data.tenantId == userTenantId()
        );
        allow write: if false;
      }
    }

    match /unit_transfers/{transferId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow write: if false;
    }

    match /bc_incomes/{incomeId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow write: if false;
    }

    match /bc_expenses/{expenseId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow write: if false;
    }

    match /bc_transfers/{transferId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow write: if false;
    }

    // P1-01 — lista negra: leitura no client; escrita só Admin SDK / BFF
    match /customer_blacklist/{entryId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow list: if isAuthenticated() && (isSuperAdmin() || userTenantId() != '');
      allow create, update, delete: if false;
    }
    // -------------------------------------------------------------

    match /business_centers/{centerId} {
      allow get: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow list: if isAuthenticated() && (isSuperAdmin() || userTenantId() != '');
      allow write: if isAuthenticated() && (isSuperAdmin() || request.resource.data.tenantId == userTenantId());
    }

    match /routes/{routeId} {
      allow get: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow list: if isAuthenticated() && (isSuperAdmin() || userTenantId() != '');
      allow write: if isAuthenticated() && (isSuperAdmin() || request.resource.data.tenantId == userTenantId());
    }

    match /devices/{deviceId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow write: if isAuthenticated() && (isSuperAdmin() || request.resource.data.tenantId == userTenantId());
    }

    match /form_responses/{responseId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow create: if isAuthenticated() && (isSuperAdmin() || request.resource.data.tenantId == userTenantId());
      allow update: if isAuthenticated() && (isSuperAdmin() || (
        resource.data.tenantId == userTenantId() &&
        (userRole() == 'admin' || userRole() == 'supervisor') &&
        request.resource.data.tenantId == resource.data.tenantId
      ));
      allow delete: if false;
    }

    match /forms/{formId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow create: if isAuthenticated() && (isSuperAdmin() || request.resource.data.tenantId == userTenantId());
      allow update: if isAuthenticated() && (isSuperAdmin() || (
        resource.data.tenantId == userTenantId() &&
        (userRole() == 'admin' || userRole() == 'supervisor') &&
        request.resource.data.tenantId == resource.data.tenantId
      ));
      allow delete: if isAuthenticated() && (isSuperAdmin() || (
        resource.data.tenantId == userTenantId() &&
        (userRole() == 'admin' || userRole() == 'supervisor')
      ));
    }

    match /holidays/{holidayId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow create: if isAuthenticated() && (isSuperAdmin() || request.resource.data.tenantId == userTenantId());
      allow update: if isAuthenticated() && (isSuperAdmin() || (
        resource.data.tenantId == userTenantId() &&
        (userRole() == 'admin' || userRole() == 'supervisor') &&
        request.resource.data.tenantId == resource.data.tenantId
      ));
      allow delete: if isAuthenticated() && (isSuperAdmin() || (
        resource.data.tenantId == userTenantId() &&
        (userRole() == 'admin' || userRole() == 'supervisor')
      ));
    }

    match /insurance_applications/{applicationId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow write: if isAuthenticated() && (isSuperAdmin() || request.resource.data.tenantId == userTenantId());
    }

    match /credit_requests/{requestId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());

      allow create: if isAuthenticated() && (isSuperAdmin() || (
        request.resource.data.tenantId == userTenantId() &&
        request.resource.data.status == 'pending'
      ));

      allow update: if isAuthenticated() && (isSuperAdmin() || (
        resource.data.tenantId == userTenantId() &&
        (userRole() == 'admin' || userRole() == 'supervisor') &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.clientId == resource.data.clientId
      ));

      allow delete: if false;
    }

    match /locations/{userId} {
      allow write: if isAuthenticated() && request.auth.uid == userId;
      
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid == userId ||
        (resource.data.tenantId == userTenantId() && 
         (userRole() == 'admin' || userRole() == 'supervisor'))
      );
    }

    match /security_logs/{logId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      // FIN-01: create apenas via Admin SDK / BFF (imutável no client)
      allow create, update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow create, update, delete: if false;
    }

    match /report_jobs/{jobId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.tenantId == userTenantId());
      allow create, update, delete: if false;
    }

    match /saas_invoices/{invoiceId} {
      allow read: if isAuthenticated() && isSuperAdmin();
      allow create, update, delete: if false;
    }
  }
}
